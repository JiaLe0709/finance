{
  "paths": {
    "@/*": [
      "./*"
    ]
  },
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "middleware.ts",
    "**/*.ts",
    "**/*.tsx",
    "pages/table.jsx"
, "components/theme-provider.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}
